{
  "name": "act-flexi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:editor --host\" \"pnpm dev:overlay --host\"",
    "dev:editor": "pnpm --filter editor dev",
    "dev:overlay": "pnpm --filter overlay dev",
    "dev:ws": "node scripts/ws-server.js",
    "build": "node scripts/build-all.js",
    "build:editor": "pnpm --filter editor build",
    "build:overlay": "pnpm --filter overlay build",
    "build:overlay:lite": "pnpm --filter overlay build:lite",
    "update-assets": "node scripts/update-assets.js",
    "preview": "cd dist/editor && npx http-server -p 3000",
    "preview:overlay": "cd dist/overlay && npx http-server -p 3001",
    "preview:lite": "cd dist/overlay-lite && npx http-server -p 3002",
    "serve": "pnpm build && pnpm preview",
    "release:check": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.0",
    "pako": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
